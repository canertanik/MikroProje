{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:YOUR_AZURE_SERVER,1433;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=False;Encrypt=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "MikroProje",
    "Audience": "MikroProjeUsers",
    "SecretKey": "REPLACE_IN_PRODUCTION_WITH_ENV_VAR_OR_SECRET",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Observability": {
    "ServiceName": "MikroProje.API",
    "Serilog": {
      "EnableFileLogging": true,
      "LogDirectory": "logs",
      "RetainedFileCountLimit": 14
    },
    "OpenTelemetry": {
      "EnableTracing": true,
      "EnableMetrics": true,
      "EnableConsoleExporter": false,
      "EnableOtlpExporter": false,
      "OtlpEndpoint": "http://otel-collector:4317",
      "SamplingRatio": 1.0
    }
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "AIChat": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "AIInsights": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "InstanceName": "MikroProje_Cache_",
    "DefaultExpirationMinutes": 10,
    "DashboardExpirationMinutes": 5,
    "ProductExpirationMinutes": 10,
    "CurrentAccountExpirationMinutes": 10,
    "WarehouseExpirationMinutes": 15,
    "SupplierPaymentExpirationMinutes": 10
  },
  "OpenAI": {
    "Enabled": true,
    "Model": "gpt-4o-mini",
    "MaxOutputTokens": 2048,
    "TimeoutSeconds": 30,
    "MaxToolCallIterations": 5,
    "BaseUrl": "https://api.openai.com/v1/"
  }
}