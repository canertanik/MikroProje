{
  "ConnectionStrings": {
    "DefaultConnection": "Server=CANERIN_PC\\MSSQLSERVER1;Database=MikroProjeDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "MikroProje",
    "Audience": "MikroProjeUsers",
    "SecretKey": "super-secret-key-that-must-be-very-long-and-secure-for-hmac-sha-256",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Observability": {
    "ServiceName": "MikroProje.API",
    "Serilog": {
      "EnableFileLogging": true,
      "LogDirectory": "logs",
      "RetainedFileCountLimit": 14
    },
    "OpenTelemetry": {
      "EnableTracing": true,
      "EnableMetrics": true,
      "EnableConsoleExporter": false,
      "EnableOtlpExporter": false,
      "OtlpEndpoint": "http://otel-collector:4317",
      "SamplingRatio": 1.0
    }
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "MikroProje_Cache_",
    "DefaultExpirationMinutes": 10,
    "DashboardExpirationMinutes": 5,
    "ProductExpirationMinutes": 10,
    "CurrentAccountExpirationMinutes": 10,
    "WarehouseExpirationMinutes": 15,
    "SupplierPaymentExpirationMinutes": 10
  }
}
